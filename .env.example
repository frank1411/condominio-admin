# Base de datos MySQL
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/condominio_admin"

# Seguridad - Generar con: openssl rand -base64 64
JWT_SECRET="tu_secreto_jwt_muy_largo_y_aleatorio"

# Configuración OAuth
OAUTH_SERVER_URL="https://tu-oauth-server.com"
VITE_APP_ID="tu_app_id"

# Usuario administrador (OpenID del primer usuario que será admin)
OWNER_OPEN_ID="open_id_del_admin"

# Almacenamiento de archivos (opcional - para imágenes de vouchers)
BUILT_IN_FORGE_API_URL="https://tu-storage-api.com"
BUILT_IN_FORGE_API_KEY="tu_api_key"

# Configuración del servidor
PORT=3000
NODE_ENV=production

# Nota: Para desarrollo local, usa NODE_ENV=development