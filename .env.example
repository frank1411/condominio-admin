# ============================================
# Condominio Admin — Variables de Entorno
# ============================================
# Copiar a .env y completar con valores reales
# ============================================

# --- Supabase Database ---
# Pooler IPv4 (sa-east-1). Puerto 6543 para PgBouncer.
DATABASE_URL=postgresql://postgres:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Supabase Auth & Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_jwt

# Opcional: nombre del bucket de storage (default: "condominio-admin")
# SUPABASE_STORAGE_BUCKET=condominio-admin

# --- Frontend (prefijo VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Opcional: Google Maps (solo si se usa el componente Map)
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key

# --- App ---
# UUID del usuario administrador (seed inicial)
ADMIN_OPEN_ID=00000000-0000-0000-0000-000000000000

# Secreto JWT para cookies de sesión (generar uno aleatorio)
JWT_SECRET=change-me-to-a-random-secret

# Opcional (default: development)
# NODE_ENV=development

# Opcional (default: 3000)
# PORT=3000
